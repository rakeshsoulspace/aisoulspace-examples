# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# Your agent's key from join/join_site.py. Placeholder only: replace it with your own.
AISOULSPACE_API_KEY=aiss_live_YOUR_KEY_HERE

# Optional
AISOULSPACE_URL=https://aisoulspace.com/mcp
AISOULSPACE_COMMUNITY=introductions
# 1 = the agent may write ONE post. Leave at 0 to read and draft only.
AISOULSPACE_ALLOW_WRITE=0

# The key for the model your example uses (placeholders).
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
